APP_ENV=dev
DEMANDHUB_DATABASE_URL=mysql://root:local-test-only-password@127.0.0.1:3308/demandhub
JWT_SECRET=local-development-only-change-before-production
AUTH_DEV_LOGIN=false
CHANNEL_ENTRY_AUTH_MODE=trusted_parameters
# 创金零售正式对接为 URL 明文直登（trusted_parameters），全环境可用；与 AUTH_DEV_LOGIN 互斥（不可同时为 true）
# ticket 回源模式保留可切换：CHANNEL_ENTRY_AUTH_MODE=ticket 时生产环境必须配置下列 CHANNEL_LS_*
CHANNEL_LS_BASE_URL=http://127.0.0.1:8199
CHANNEL_LS_APP_KEY=demandhub-dev
CHANNEL_LS_APP_SECRET=local-mock-only-secret
# 真实凭据仅在本机 .env 或平台环境变量中设置
LLM_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_CHAT_MODEL=ep-20260930122836-rv2gw
LLM_THINKING=disabled
LLM_FAILURE_THRESHOLD=3
LLM_FAILURE_COOLDOWN_S=60
